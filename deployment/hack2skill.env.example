# Copied to /etc/hack2skill.env by setup.sh (readable by root only). Edit it, then: systemctl restart hack2skill

# Optional Care Assistant. Leave empty to keep it off. Needs: venv/bin/pip install -r requirements-assistant.txt
ANTHROPIC_API_KEY=

# Key for the audit log's hash chain. Make one with: openssl rand -hex 32
PP_AUDIT_KEY=

# Messaging stays a practice run unless you fill in the Twilio details (see the README)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=
