[Unit]
Description=Precision Prevention and Screening (Hack2Skill)
After=network.target

[Service]
User=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=-/etc/hack2skill.env
# one process only: sessions, limits and the audit log are files under outputs/
ExecStart=__APP_DIR__/venv/bin/python server.py --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
