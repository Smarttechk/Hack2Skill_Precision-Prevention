<mxfile host="app.diagrams.net"><diagram name="Architecture" id="arch1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="layer2" value="1  Who uses it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6F7E;strokeWidth=2;fontColor=#1F6F7E;fontSize=14;fontStyle=1;fontFamily=Times New Roman;align=left;verticalAlign=top;arcSize=3;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1160" height="100" as="geometry"/></mxCell><mxCell id="layer3" value="2  The web app (English and Arabic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6F7E;strokeWidth=2;fontColor=#1F6F7E;fontSize=14;fontStyle=1;fontFamily=Times New Roman;align=left;verticalAlign=top;arcSize=3;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="1160" height="100" as="geometry"/></mxCell><mxCell id="layer4" value="3  The server: one Python program that serves the API and the web app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6F7E;strokeWidth=2;fontColor=#1F6F7E;fontSize=14;fontStyle=1;fontFamily=Times New Roman;align=left;verticalAlign=top;arcSize=3;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="360" width="1160" height="250" as="geometry"/></mxCell><mxCell id="layer5" value="4  Decision logic and the batch run (nothing is trained)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6F7E;strokeWidth=2;fontColor=#1F6F7E;fontSize=14;fontStyle=1;fontFamily=Times New Roman;align=left;verticalAlign=top;arcSize=3;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="670" width="1160" height="290" as="geometry"/></mxCell><mxCell id="layer6" value="5  Where the data lives" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6F7E;strokeWidth=2;fontColor=#1F6F7E;fontSize=14;fontStyle=1;fontFamily=Times New Roman;align=left;verticalAlign=top;arcSize=3;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="1020" width="1160" height="150" as="geometry"/></mxCell><mxCell id="box7" value="&lt;b&gt;Patient or family&lt;/b&gt;&lt;br&gt;See what is due, choose how to be contacted, add a child" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F1F3;strokeColor=#1F6F7E;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="32" y="74" width="204" height="58" as="geometry"/></mxCell><mxCell id="box8" value="&lt;b&gt;Doctor&lt;/b&gt;&lt;br&gt;Sees only their own patients and agrees or disagrees with each flag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F1F3;strokeColor=#1F6F7E;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="262" y="74" width="204" height="58" as="geometry"/></mxCell><mxCell id="box9" value="&lt;b&gt;Outreach staff&lt;/b&gt;&lt;br&gt;Call the people on today's list and record what happened" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F1F3;strokeColor=#1F6F7E;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="492" y="74" width="204" height="58" as="geometry"/></mxCell><mxCell id="box10" value="&lt;b&gt;Hospital admin&lt;/b&gt;&lt;br&gt;Daily action list, audit page, accounts and care teams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F1F3;strokeColor=#1F6F7E;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="722" y="74" width="204" height="58" as="geometry"/></mxCell><mxCell id="box11" value="&lt;b&gt;Programme manager&lt;/b&gt;&lt;br&gt;Sees totals only, never an individual's record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F1F3;strokeColor=#1F6F7E;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="952" y="74" width="204" height="58" as="geometry"/></mxCell><mxCell id="box12" value="&lt;b&gt;Doctor view&lt;/b&gt;&lt;br&gt;risk, reasons and a short form for clinic answers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="32" y="234" width="168" height="58" as="geometry"/></mxCell><mxCell id="box13" value="&lt;b&gt;Outreach queue&lt;/b&gt;&lt;br&gt;who to call, booked visits, who was contacted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="220" y="234" width="168" height="58" as="geometry"/></mxCell><mxCell id="box14" value="&lt;b&gt;My care&lt;/b&gt;&lt;br&gt;what is due, consent choices, family members" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="408" y="234" width="168" height="58" as="geometry"/></mxCell><mxCell id="box15" value="&lt;b&gt;Today and Audit&lt;/b&gt;&lt;br&gt;what needs action, and who opened which record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="596" y="234" width="168" height="58" as="geometry"/></mxCell><mxCell id="box16" value="&lt;b&gt;Overview, Results, Map, Communities&lt;/b&gt;&lt;br&gt;totals, comparison with usual care, where help is needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="784" y="234" width="168" height="58" as="geometry"/></mxCell><mxCell id="box17" value="&lt;b&gt;Preview as&lt;/b&gt;&lt;br&gt;try any role without a password (demo mode)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="972" y="234" width="168" height="58" as="geometry"/></mxCell><mxCell id="box18" value="&lt;b&gt;Sign-in&lt;/b&gt;&lt;br&gt;passwords are stored as hashes; five wrong tries lock the account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="32" y="398" width="170" height="100" as="geometry"/></mxCell><mxCell id="box19" value="&lt;b&gt;Roles and care teams&lt;/b&gt;&lt;br&gt;a doctor sees only their own patients; emergency access needs a reason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="222" y="398" width="170" height="100" as="geometry"/></mxCell><mxCell id="box20" value="&lt;b&gt;Family and clinic answers&lt;/b&gt;&lt;br&gt;parents add a child; clinics add waist and lifestyle answers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="412" y="398" width="170" height="100" as="geometry"/></mxCell><mxCell id="box21" value="&lt;b&gt;Audit log&lt;/b&gt;&lt;br&gt;every record opened is logged, and any tampering shows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="602" y="398" width="170" height="100" as="geometry"/></mxCell><mxCell id="box22" value="&lt;b&gt;FHIR read API&lt;/b&gt;&lt;br&gt;lets a hospital system read a record in the standard format" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="792" y="398" width="170" height="100" as="geometry"/></mxCell><mxCell id="box23" value="&lt;b&gt;Outreach and visits&lt;/b&gt;&lt;br&gt;stores each call and visit result; the queue reads them back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="982" y="398" width="170" height="100" as="geometry"/></mxCell><mxCell id="box24" value="&lt;b&gt;Risk on demand&lt;/b&gt;&lt;br&gt;Works out the diabetes chance again when a clinic adds answers, and the heart figure shown to the doctor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="32" y="508" width="360" height="90" as="geometry"/></mxCell><mxCell id="box25" value="&lt;b&gt;Consent and chat&lt;/b&gt;&lt;br&gt;Families can reply BOOK or STOP, emergency words get the 998 message, and genetic results are used only with consent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="412" y="508" width="360" height="90" as="geometry"/></mxCell><mxCell id="box26" value="&lt;b&gt;Safety checks&lt;/b&gt;&lt;br&gt;Security headers, a limit on request size, a health check, and no start on a network without sign-in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="792" y="508" width="360" height="90" as="geometry"/></mxCell><mxCell id="box27" value="&lt;b&gt;Risk scores, all published&lt;/b&gt;&lt;br&gt;Diabetes: the FINDRISC questionnaire adjusted to UAE levels. Heart: the ACC/AHA equations, shown for information only. Blood pressure: the measured reading and its guideline category." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="32" y="708" width="360" height="100" as="geometry"/></mxCell><mxCell id="box28" value="&lt;b&gt;Care teams and consent&lt;/b&gt;&lt;br&gt;Doctors are matched to patients by specialty, language and how full their list is, urgent people first. Consent decides who may be contacted at all." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10.5;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="412" y="708" width="420" height="100" as="geometry"/></mxCell><mxCell id="box29" value="&lt;b&gt;Seven agents&lt;/b&gt;&lt;br&gt;Care gaps, risk, priority, outreach, chat, follow-up and evaluation. Urgent people come first." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F1F3;strokeColor=#1F6F7E;strokeWidth=1.5;fontColor=#2B2520;fontSize=10.5;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="872" y="708" width="280" height="100" as="geometry"/></mxCell><mxCell id="box31" value="&lt;b&gt;1  Build the data&lt;/b&gt;&lt;br&gt;Creates the 5,000 simulated residents, adjusts them to UAE figures and fills the records database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="32" y="846" width="150" height="100" as="geometry"/></mxCell><mxCell id="box32" value="&lt;b&gt;2  Check the scores&lt;/b&gt;&lt;br&gt;Tests the diabetes score on real NHANES adults" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="222" y="846" width="150" height="100" as="geometry"/></mxCell><mxCell id="box33" value="&lt;b&gt;3  Set up the scores&lt;/b&gt;&lt;br&gt;Adjusts the published diabetes score to UAE levels and writes the model card" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="412" y="846" width="150" height="100" as="geometry"/></mxCell><mxCell id="box34" value="&lt;b&gt;4  Calibrate&lt;/b&gt;&lt;br&gt;Tunes usual care to match published UAE figures" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="602" y="846" width="150" height="100" as="geometry"/></mxCell><mxCell id="box35" value="&lt;b&gt;5  Compare with usual care&lt;/b&gt;&lt;br&gt;Runs this system and usual care side by side on the same people, with the same daily staff capacity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F1F3;strokeColor=#1F6F7E;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="792" y="846" width="150" height="100" as="geometry"/></mxCell><mxCell id="box36" value="&lt;b&gt;6  Evaluate&lt;/b&gt;&lt;br&gt;Outcomes, fairness by group, worst case and cost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="982" y="846" width="150" height="100" as="geometry"/></mxCell><mxCell id="box42" value="&lt;b&gt;Simulated population&lt;/b&gt;&lt;br&gt;5,000 Abu Dhabi residents. The numbers behind them are listed with their sources." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="32" y="1058" width="180" height="102" as="geometry"/></mxCell><mxCell id="box43" value="&lt;b&gt;NHANES survey&lt;/b&gt;&lt;br&gt;Real US survey data, used only to check the scores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="232" y="1058" width="150" height="102" as="geometry"/></mxCell><mxCell id="box44" value="&lt;b&gt;Results from the batch run&lt;/b&gt;&lt;br&gt;The people list, events, messages, results and the model card" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F1F3;strokeColor=#1F6F7E;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="402" y="1058" width="230" height="102" as="geometry"/></mxCell><mxCell id="box45" value="&lt;b&gt;Files the app writes&lt;/b&gt;&lt;br&gt;Access log, sign-ins, care teams, outreach contacts, family requests and clinic answers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0E8;strokeColor=#D6CDBC;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="652" y="1058" width="230" height="102" as="geometry"/></mxCell><mxCell id="box46" value="&lt;b&gt;Hospital records database&lt;/b&gt;&lt;br&gt;Patients, visits, diagnoses, results, vaccines, procedures, family history, genetics and consent, in FHIR-style tables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F1F3;strokeColor=#1F6F7E;strokeWidth=1.5;fontColor=#2B2520;fontSize=10;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="902" y="1058" width="246" height="102" as="geometry"/></mxCell><mxCell id="box47" value="&lt;b&gt;Contact channels&lt;/b&gt;&lt;br&gt;WhatsApp, SMS, phone or a visit, chosen by the outreach agent. Simulated for now." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6E645B;strokeWidth=1.5;fontColor=#2B2520;fontSize=10.5;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1300" y="708" width="220" height="100" as="geometry"/></mxCell><mxCell id="box48" value="&lt;b&gt;Hospital / Malaffi&lt;/b&gt;&lt;br&gt;Records come in through the import script and go out through the read API. To be connected in a pilot." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6E645B;strokeWidth=1.5;fontColor=#2B2520;fontSize=10.5;fontFamily=Times New Roman;arcSize=6;align=center;verticalAlign=middle;spacing=5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1300" y="1058" width="220" height="102" as="geometry"/></mxCell><mxCell id="arrow37" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#1F6F7E;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="182" y="896" as="sourcePoint"/><mxPoint x="222" y="896" as="targetPoint"/></mxGeometry></mxCell><mxCell id="arrow38" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#1F6F7E;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="372" y="896" as="sourcePoint"/><mxPoint x="412" y="896" as="targetPoint"/></mxGeometry></mxCell><mxCell id="arrow39" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#1F6F7E;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="562" y="896" as="sourcePoint"/><mxPoint x="602" y="896" as="targetPoint"/></mxGeometry></mxCell><mxCell id="arrow40" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#1F6F7E;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="752" y="896" as="sourcePoint"/><mxPoint x="792" y="896" as="targetPoint"/></mxGeometry></mxCell><mxCell id="arrow41" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#1F6F7E;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="942" y="896" as="sourcePoint"/><mxPoint x="982" y="896" as="targetPoint"/></mxGeometry></mxCell><mxCell id="arrow49" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#1F6F7E;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="140" as="sourcePoint"/><mxPoint x="600" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="arrow51" value="" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;rounded=0;strokeColor=#1F6F7E;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="300" as="sourcePoint"/><mxPoint x="600" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="arrow53" value="" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;rounded=0;strokeColor=#1F6F7E;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="610" as="sourcePoint"/><mxPoint x="600" y="670" as="targetPoint"/></mxGeometry></mxCell><mxCell id="arrow55" value="" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;rounded=0;strokeColor=#1F6F7E;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="960" as="sourcePoint"/><mxPoint x="600" y="1020" as="targetPoint"/></mxGeometry></mxCell><mxCell id="arrow57" value="" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;rounded=0;strokeColor=#6E645B;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1152" y="758" as="sourcePoint"/><mxPoint x="1300" y="758" as="targetPoint"/></mxGeometry></mxCell><mxCell id="arrow59" value="" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;rounded=0;strokeColor=#6E645B;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1148" y="1109" as="sourcePoint"/><mxPoint x="1300" y="1109" as="targetPoint"/></mxGeometry></mxCell><mxCell id="title1" value="Precision Prevention and Screening: how the system fits together" style=