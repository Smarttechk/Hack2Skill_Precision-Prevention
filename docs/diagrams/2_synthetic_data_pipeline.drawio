<mxfile host="app.diagrams.net" agent="make_drawio.py" version="24.7.17">
  <diagram id="pipeline" name="2 Synthetic data pipeline">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="780" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Synthetic patients are built in four stages, then checked by 25 tests" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1F1F1F;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="24" y="10" width="720" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Left: what our scripts do. Right, dashed: the real data each stage uses." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5F5F5F;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="24" y="38" width="720" height="20" as="geometry" />
        </mxCell>
        <mxCell id="g" value="&lt;b&gt;1. Generate with Synthea&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F5F5F&quot;&gt;6 runs, one per age and sex group: 5,000 living people, about 10 minutes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#1F1F1F;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="24" y="72" width="480" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c" value="&lt;b&gt;2. Combine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F5F5F&quot;&gt;stack the runs into data/raw; drop 5 unused files (billing, supplies, imaging)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#1F1F1F;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="24" y="152" width="480" height="56" as="geometry" />
        </mxCell>
        <mxCell id="m" value="&lt;b&gt;3. Map codes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F5F5F&quot;&gt;match 30 project fields to codes, such as HbA1c, BMI, well-child visit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#1F1F1F;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="24" y="232" width="480" height="56" as="geometry" />
        </mxCell>
        <mxCell id="adj" value="4. Adjust to the UAE (uae_adjust.py)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;fontStyle=1;fillColor=#F3F3F1;strokeColor=#BDBDBD;fontColor=#1F1F1F;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="24" y="312" width="480" height="276" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="a. Homes in 401 real places, distance to the nearest of 360 health facilities" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=middle;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#BDBDBD;fontColor=#1F1F1F;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="adj">
          <mxGeometry x="16" y="32" width="448" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="b. People: nationality, language, insurance, shifts, guardians" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=middle;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#BDBDBD;fontColor=#1F1F1F;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="adj">
          <mxGeometry x="16" y="80" width="448" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="c. Missed well-child visits, tuned to a 92% second measles dose" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=middle;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#BDBDBD;fontColor=#1F1F1F;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="adj">
          <mxGeometry x="16" y="128" width="448" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="d. Hidden diabetes and hypertension and smoking, matched to WHO totals" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=middle;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#BDBDBD;fontColor=#1F1F1F;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="adj">
          <mxGeometry x="16" y="176" width="448" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="e. Remove records dated in the future" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=middle;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#BDBDBD;fontColor=#1F1F1F;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="adj">
          <mxGeometry x="16" y="224" width="448" height="40" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="&lt;b&gt;Adjusted records&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F5F5F&quot;&gt;data/processed/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#1F1F1F;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="24" y="614" width="152" height="56" as="geometry" />
