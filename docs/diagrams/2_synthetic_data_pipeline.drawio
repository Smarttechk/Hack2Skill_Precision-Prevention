        <mxCell id="who" value="&lt;b&gt;WHO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F5F5F&quot;&gt;measles second dose,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F5F5F&quot;&gt;diabetes, hypertension,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F5F5F&quot;&gt;smoking targets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;dashPattern=4 3;fontColor=#1F1F1F;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
