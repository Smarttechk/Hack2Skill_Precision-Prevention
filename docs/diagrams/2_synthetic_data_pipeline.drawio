        <mxCell id="o2" value="&lt;b&gt;Truth file&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F5F5F&quot;&gt;simulation only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#1F1F1F;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="188" y="614" width="152" height="56" as="geometry" />
