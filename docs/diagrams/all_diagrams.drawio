        <mxCell id="s1" value="&lt;b&gt;Synthea&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F5F5F&quot;&gt;synthetic patients,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F5F5F&quot;&gt;6 age-sex groups&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#1F1F1F;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="b1">
