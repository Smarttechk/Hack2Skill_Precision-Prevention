          <mxGeometry x="230" y="32" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;Truth file (locked)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F5F5F&quot;&gt;hidden cases, used only&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F5F5F&quot;&gt;by the simulation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#1F1F1F;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="b2">
          <mxGeometry x="444" y="32" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;Care-gap rules&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F5F5F&quot;&gt;24 guideline rules,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F5F5F&quot;&gt;warning signs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#1F1F1F;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="b3">
          <mxGeometry x="16" y="32" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;Risk score&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F5F5F&quot;&gt;published FINDRISC,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F5F5F&quot;&gt;reasons, range, NHANES-checked&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#1F1F1F;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="b3">
          <mxGeometry x="230" y="32" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Pathway cards&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F5F5F&quot;&gt;outreach invite or&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F5F5F&quot;&gt;clinician decides&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#1F1F1F;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="b3">
          <mxGeometry x="444" y="32" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;No-show rule&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F5F5F&quot;&gt;adds support only,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F5F5F&quot;&gt;never lowers priority&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#1F1F1F;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="b3">
          <mxGeometry x="16" y="116" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;Follow-up learner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F5F5F&quot;&gt;picks reminder, channel&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#5F5F5F&quot;&gt;or health worker&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#1F1F1F;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="b3">
          <mxGeometry x="230" y="116" width="200" height="72" as="geometry" />
